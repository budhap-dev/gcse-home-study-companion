      "topics": [
        "kinetic-and-gravitational-potential-energy",
        "hookes-law",
        "thermal-physics",
        "power-and-efficiency",
        "current-potential-difference-and-resistance",
        "resistance-and-ohms-law",
        "mains-electricity",
        "density-and-changes-of-state",
        "behaviour-of-gases",
        "resultant-forces",
        "newtons-laws",
        "moments-levers-and-gears",
        "pressure-in-fluids",
        "describing-motion",
        "stopping-distances",
        "momentum",
        "wave-properties",
        "lenses",
        "electromagnetic-devices"
      ],
      "applications": [
        {
          "title": "Car crash safety",
          "body": "Crumple zones and airbags make the stop take longer. With $F = \\dfrac{m\\,\\Delta v}{\\Delta t}$, the same change in momentum over a longer time means a smaller force on the passenger."
        },
        {
          "title": "Your electricity bill",
          "body": "A 2 kW kettle running for a quarter of an hour uses $E = P\\,t = 2 \\times 0.25 = 0.5$ kWh. The bill is that number times the price per kilowatt-hour."
        },
        {
          "title": "Wi-Fi and radio",
          "body": "A 2.4 GHz Wi-Fi signal travels at $3 \\times 10^8$ m/s, so $\\lambda = \\dfrac{v}{f} = 0.125$ m: about 12.5 cm, which sets the size of the aerial inside a router."
        },
        {
          "title": "Charging a phone",
          "body": "A phone charger is a transformer. It steps 230 V mains down to about 5 V, so its coils have roughly 46 times as many turns on the primary as on the secondary."
        }
      ],
      "blocks": [
        {
          "kind": "formulae",
          "groups": [
            {
              "title": "Energy",
              "colour": "#c2410c",
              "items": [
                {
                  "name": "Kinetic energy",
                  "formula": "$E_k = \\tfrac{1}{2}\\,m\\,v^2$",
                  "symbols": "$E_k$ kinetic energy (J), $m$ mass (kg), $v$ speed (m/s)"
                },
                {
                  "name": "Elastic potential energy",
                  "formula": "$E_e = \\tfrac{1}{2}\\,k\\,e^2$",
                  "symbols": "$k$ spring constant (N/m), $e$ extension (m). Only while the limit of proportionality is not exceeded."
                },
                {
                  "name": "Gravitational potential energy",
                  "formula": "$E_p = m\\,g\\,h$",
                  "symbols": "$g$ gravitational field strength (N/kg), $h$ height (m)"
                },
                {
                  "name": "Change in thermal energy",
                  "formula": "$\\Delta E = m\\,c\\,\\Delta\\theta$",
                  "symbols": "$c$ specific heat capacity (J/kg °C), $\\Delta\\theta$ temperature change (°C)"
                },
                {
                  "name": "Power from energy",
                  "formula": "$P = \\dfrac{E}{t}$",
                  "symbols": "$P$ power (W), $E$ energy transferred (J), $t$ time (s)"
                },
                {
                  "name": "Power from work",
                  "formula": "$P = \\dfrac{W}{t}$",
                  "symbols": "$W$ work done (J)"
                },
                {
                  "name": "Efficiency from energy",
                  "formula": "$\\text{efficiency} = \\dfrac{\\text{useful output energy}}{\\text{total input energy}}$",
                  "symbols": "A fraction or a percentage, with no unit. The sheet says \"useful output energy transfer\" over \"total input energy transfer\"."
                },
                {
                  "name": "Efficiency from power",
                  "formula": "$\\text{efficiency} = \\dfrac{\\text{useful power output}}{\\text{total power input}}$",
                  "symbols": "No unit. Never more than 1, or 100%."
                }
              ]
            },
            {
              "title": "Electricity",
              "colour": "#1d4ed8",
              "items": [
                {
                  "name": "Charge flow",
                  "formula": "$Q = I\\,t$",
                  "symbols": "$Q$ charge (C), $I$ current (A), $t$ time (s)"
                },
                {
                  "name": "Potential difference",
                  "formula": "$V = I\\,R$",
                  "symbols": "$V$ potential difference (V), $R$ resistance (Ω)"
                },
                {
                  "name": "Power from pd and current",
                  "formula": "$P = V\\,I$",
                  "symbols": "$P$ power (W)"
                },
                {
                  "name": "Power from current and resistance",
                  "formula": "$P = I^2\\,R$",
                  "symbols": "Square the current first, then multiply."
                },
                {
                  "name": "Energy from power",
                  "formula": "$E = P\\,t$",
                  "symbols": "$E$ energy transferred (J), $t$ time (s)"
                },
                {
                  "name": "Energy from charge",
                  "formula": "$E = Q\\,V$",
                  "symbols": "$Q$ charge flow (C), $V$ potential difference (V)"
                }
              ]
            },
            {
              "title": "Particle model of matter",
              "colour": "#047857",
              "items": [
                {
                  "name": "Density",
                  "formula": "$\\rho = \\dfrac{m}{V}$",
                  "symbols": "$\\rho$ density (kg/m³), $m$ mass (kg), $V$ volume (m³)"
                },
                {
                  "name": "Change of state",
                  "formula": "$E = m\\,L$",
                  "symbols": "$L$ specific latent heat (J/kg). No temperature change: the energy breaks or makes bonds."
                },
                {
                  "name": "Gas pressure and volume",
                  "formula": "$p\\,V = \\text{constant}$",
                  "symbols": "$p$ pressure (Pa), $V$ volume (m³). For a fixed mass of gas at constant temperature, so $p_1V_1 = p_2V_2$."
                }
              ]
            },
            {
              "title": "Forces and motion",
              "colour": "#6d28d9",
              "items": [
                {
                  "name": "Weight",
                  "formula": "$W = m\\,g$",
                  "symbols": "$W$ weight (N), $g$ gravitational field strength (N/kg)"
                },
                {
                  "name": "Work done",
                  "formula": "$W = F\\,s$",
                  "symbols": "$W$ work done (J), $F$ force (N), $s$ distance along the line of the force (m)"
                },
                {
                  "name": "Force on a spring",
                  "formula": "$F = k\\,e$",
                  "symbols": "$k$ spring constant (N/m), $e$ extension (m)"
                },
                {
                  "name": "Moment",
                  "formula": "$M = F\\,d$",
                  "symbols": "$M$ moment (N m), $d$ perpendicular distance from the pivot to the line of the force (m)"
                },
                {
                  "name": "Pressure",
                  "formula": "$p = \\dfrac{F}{A}$",
                  "symbols": "$p$ pressure (Pa), $F$ force at right angles to the surface (N), $A$ area (m²)"
                },
                {
                  "name": "Pressure in a liquid",
                  "formula": "$p = h\\,\\rho\\,g$",
                  "symbols": "$h$ height of the column (m), $\\rho$ density of the liquid (kg/m³)",
                  "higher": true
                },
                {
                  "name": "Distance",
                  "formula": "$s = v\\,t$",
                  "symbols": "$s$ distance (m), $v$ speed (m/s), $t$ time (s)"
                },
                {
                  "name": "Acceleration",
                  "formula": "$a = \\dfrac{\\Delta v}{t}$",
                  "symbols": "$a$ acceleration (m/s²), $\\Delta v$ change in velocity (m/s)"
                },
                {
                  "name": "Uniform acceleration",
                  "formula": "$v^2 - u^2 = 2\\,a\\,s$",
                  "symbols": "$v$ final velocity, $u$ initial velocity (m/s), $s$ distance (m)"
                },
                {
                  "name": "Resultant force",
                  "formula": "$F = m\\,a$",
                  "symbols": "$F$ resultant force (N), $m$ mass (kg), $a$ acceleration (m/s²)"
                },
                {
                  "name": "Momentum",
                  "formula": "$p = m\\,v$",
                  "symbols": "$p$ momentum (kg m/s), $v$ velocity (m/s)",
                  "higher": true
                },
                {
                  "name": "Force and change in momentum",
                  "formula": "$F = \\dfrac{m\\,\\Delta v}{\\Delta t}$",
                  "symbols": "$m\\,\\Delta v$ change in momentum (kg m/s), $\\Delta t$ time taken (s)",
                  "higher": true
                }
              ]
            },
            {
              "title": "Waves",
              "colour": "#0e7490",
              "items": [
                {
                  "name": "Period",
                  "formula": "$T = \\dfrac{1}{f}$",
                  "symbols": "$T$ period (s), $f$ frequency (Hz)"
                },
                {
                  "name": "Wave speed",
                  "formula": "$v = f\\,\\lambda$",
                  "symbols": "$v$ wave speed (m/s), $\\lambda$ wavelength (m)"
                },
                {
                  "name": "Magnification",
                  "formula": "$\\text{magnification} = \\dfrac{\\text{image height}}{\\text{object height}}$",
                  "symbols": "A ratio, so no unit. Physics only, with lenses."
                }
              ]
            },
            {
              "title": "Magnetism and electromagnetism",
              "colour": "#be185d",
              "items": [
                {
                  "name": "Force on a conductor",
                  "formula": "$F = B\\,I\\,l$",
                  "symbols": "$B$ magnetic flux density (T), $I$ current (A), $l$ length in the field (m). At right angles to the field.",
                  "higher": true
                },
                {
                  "name": "Transformer turns",
                  "formula": "$\\dfrac{V_p}{V_s} = \\dfrac{n_p}{n_s}$",
                  "symbols": "$V$ potential difference (V), $n$ number of turns, $p$ primary coil, $s$ secondary coil",
                  "higher": true
                },
                {
                  "name": "Transformer power",
                  "formula": "$V_p\\,I_p = V_s\\,I_s$",
                  "symbols": "Power in equals power out, for a transformer that is 100% efficient.",
                  "higher": true
                }
              ]
            }
          ]
        }
      ]
