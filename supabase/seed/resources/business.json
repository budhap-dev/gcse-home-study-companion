      "blocks": [
        {
          "kind": "formulae",
          "groups": [
            {
              "title": "Costs and revenue",
              "colour": "#8a6d1d",
              "items": [
                {
                  "name": "Total costs",
                  "formula": "$\\text{TC} = \\text{TFC} + \\text{TVC}$",
                  "symbols": "Fixed costs £2,000, plus £3 a unit for 500 units: $2000 + 1500 = £3500$"
                },
                {
                  "name": "Revenue",
                  "formula": "$\\text{revenue} = \\text{price} \\times \\text{quantity}$",
                  "symbols": "$£8 \\times 500 = £4000$"
                }
              ]
            },
            {
              "title": "Break even",
              "colour": "#1d4ed8",
              "items": [
                {
                  "name": "Break-even point in units",
                  "formula": "$\\dfrac{\\text{fixed costs}}{\\text{sales price} - \\text{variable cost}}$",
                  "symbols": "$\\dfrac{2000}{8 - 3} = 400$ units. The bottom line is the contribution per unit."
                },
                {
                  "name": "Break-even point in revenue",
                  "formula": "$\\text{break-even units} \\times \\text{sales price}$",
                  "symbols": "$400 \\times £8 = £3200$"
                },
                {
                  "name": "Margin of safety",
                  "formula": "$\\text{actual or budgeted sales} - \\text{break-even sales}$",
                  "symbols": "$500 - 400 = 100$ units: sales could fall by 100 before a loss"
                }
              ]
            },
            {
              "title": "Cash flow",
              "colour": "#047857",
              "items": [
                {
                  "name": "Net cash flow",
                  "formula": "$\\text{cash inflows} - \\text{cash outflows}$",
                  "symbols": "In a month: $£5000 - £4200 = £800$"
                },
                {
                  "name": "Opening balance",
                  "formula": "$\\text{opening balance} = \\text{closing balance of the previous period}$",
                  "symbols": "Last month closed at £300, so this month opens at £300"
                },
                {
                  "name": "Closing balance",
                  "formula": "$\\text{opening balance} + \\text{net cash flow}$",
                  "symbols": "$£300 + £800 = £1100$, which is next month's opening balance"
                }
              ]
            },
            {
              "title": "Profit",
              "colour": "#b3261e",
              "items": [
                {
                  "name": "Gross profit",
                  "formula": "$\\text{sales revenue} - \\text{cost of sales}$",
                  "symbols": "$£4000 - £1500 = £2500$"
                },
                {
                  "name": "Gross profit margin",
                  "formula": "$\\dfrac{\\text{gross profit}}{\\text{sales revenue}} \\times 100$",
                  "symbols": "$\\dfrac{2500}{4000} \\times 100 = 62.5\\%$"
                },
                {
                  "name": "Net profit",
                  "formula": "$\\text{gross profit} - \\text{other operating expenses and interest}$",
                  "symbols": "$£2500 - £1700 = £800$"
                },
                {
                  "name": "Net profit margin",
                  "formula": "$\\dfrac{\\text{net profit}}{\\text{sales revenue}} \\times 100$",
                  "symbols": "$\\dfrac{800}{4000} \\times 100 = 20\\%$"
                }
              ]
            },
            {
              "title": "Loans and investment",
              "colour": "#6d28d9",
              "items": [
                {
                  "name": "Interest on loans",
                  "formula": "$\\dfrac{\\text{total repayment} - \\text{borrowed amount}}{\\text{borrowed amount}} \\times 100$",
                  "symbols": "Borrow £1000, repay £1200: $\\dfrac{200}{1000} \\times 100 = 20\\%$"
                },
                {
                  "name": "Average rate of return",
                  "formula": "$\\dfrac{\\text{average annual profit}}{\\text{cost of investment}} \\times 100$",
                  "symbols": "Average annual profit is total profit ÷ years: £6000 over 3 years on £10 000 is $\\dfrac{2000}{10\\,000} \\times 100 = 20\\%$"
                }
              ]
            }
          ]
        }
      ],
      "applications": [
        {
          "title": "Pricing a school fair stall",
          "body": "A cake stall pays £40 for the pitch and £0.50 a cake, and sells cakes at £1.50. It breaks even at $40 \\div (1.50 - 0.50) = 40$ cakes; every cake after that is profit."
        },
        {
          "title": "Choosing a loan",
          "body": "A bank offering £5000 repaid as £5750 charges $\\dfrac{750}{5000} \\times 100 = 15\\%$. Working that out lets a business compare lenders on the same terms."
        }
      ]
    }
  ],
