  "lesson": {
    "steps": [
      {
        "id": "s1",
        "kind": "explain",
        "title": "Gradient and intercept",
        "body": "Every straight line has an equation $y = mx + c$. **$m$** is the gradient: how far up the line goes for each 1 across. **$c$** is where it crosses the $y$-axis.\n\nOn the graph, $y = 2x + 1$ crosses at $(0, 1)$ and climbs 2 for every 1 across.",
        "visuals": [
          {
            "type": "diagram",
            "component": "line-graph",
            "props": {
              "xRange": [
                -5,
                5
              ],
              "yRange": [
                -5,
                5
              ],
              "lines": [
                {
                  "m": 2,
                  "c": 1,
                  "label": "y = 2x + 1"
                }
              ],
              "points": [
                {
                  "x": 0,
                  "y": 1,
                  "label": "(0, 1)"
                },
                {
                  "x": 1,
                  "y": 3,
                  "label": "(1, 3)"
                }
              ]
            },
            "alt": "The line y equals 2x plus 1 crossing the y-axis at 1 and rising two for each one across, with the points (0, 1) and (1, 3) marked"
          }
        ],
        "check": {
          "id": "c1",
          "type": "short-text",
          "prompt": "What is the gradient of $y = 5x - 3$?",
          "marks": 1,
          "gradeBand": "4-5",
          "skill": "reading gradient from an equation",
          "calculator": "either",
          "tags": [],
          "solution": "The number multiplying $x$ is the gradient: 5.",
          "markScheme": [
