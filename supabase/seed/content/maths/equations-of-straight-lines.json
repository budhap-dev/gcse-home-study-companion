                  "label": "M (5, 6)"
                }
              ]
            },
            "alt": "Points A at (1, 3), B at (9, 9) and the midpoint M at (5, 6) marked on the line through A and B"
          },
          {
            "type": "worked-example",
            "problem": "Midpoint and length of $PQ$ for $P(-3, 1)$ and $Q(5, 7)$",
            "steps": [
              {
                "text": "Midpoint: $\\left(\\dfrac{-3 + 5}{2}, \\dfrac{1 + 7}{2}\\right) = (1, 4)$"
              },
              {
                "text": "Change in $x$ is $8$, change in $y$ is $6$"
              },
              {
                "text": "$PQ = \\sqrt{8^2 + 6^2} = \\sqrt{100} = 10$"
              }
            ]
          }
