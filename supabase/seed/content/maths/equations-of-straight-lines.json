  "tips": [
    {
      "kind": "remember",
      "title": "y = mx + c, m is the slope",
      "body": "$m$ is the gradient and $c$ is where the line crosses the $y$-axis. Rearrange into that form **before** reading either off: in $2y = 6x + 8$ the gradient is 3, not 6."
    },
    {
      "kind": "shortcut",
      "title": "Rise over run, same order both ways",
      "body": "$m = \\dfrac{y_2 - y_1}{x_2 - x_1}$. Subtract the points in the **same order** on top and bottom. Swapping the order on one line only flips the sign and is the most common error."
    },
    {
      "kind": "check",
      "title": "Does the sign match the picture?",
      "body": "A line going up to the right has a **positive** gradient; down to the right is **negative**. Sketch it and check your sign before writing the equation."
    }
  ],
  "lesson": {
    "steps": [
      {
        "id": "s1",
        "kind": "explain",
        "title": "Gradient and intercept",
        "body": "Every straight line has an equation $y = mx + c$. **$m$** is the gradient: how far up the line goes for each 1 across. **$c$** is where it crosses the $y$-axis.\n\nOn the graph, $y = 2x + 1$ crosses at $(0, 1)$ and climbs 2 for every 1 across.",
        "visuals": [
          {
            "type": "diagram",
            "component": "line-graph",
            "props": {
              "xRange": [
                -5,
                5
              ],
              "yRange": [
                -5,
                5
              ],
              "lines": [
                {
                  "m": 2,
                  "c": 1,
                  "label": "y = 2x + 1"
                }
              ],
              "points": [
                {
                  "x": 0,
                  "y": 1,
                  "label": "(0, 1)"
                },
                {
                  "x": 1,
                  "y": 3,
                  "label": "(1, 3)"
                }
              ]
            },
            "alt": "The line y equals 2x plus 1 crossing the y-axis at 1 and rising two for each one across, with the points (0, 1) and (1, 3) marked"
          },
          {
            "type": "worked-example",
            "problem": "Write down the gradient and the $y$-intercept of $y = 3 - 2x$.",
            "steps": [
              {
                "text": "Rearrange to the form $y = mx + c$: $y = -2x + 3$"
              },
              {
                "text": "Gradient $m = -2$: the number multiplying $x$, including its sign"
              },
              {
                "text": "$y$-intercept $c = 3$: the line crosses the $y$-axis at $(0, 3)$"
              }
            ]
          }
        ],
        "check": {
