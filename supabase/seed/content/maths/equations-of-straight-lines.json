      {
        "id": "s3",
        "kind": "explain",
        "title": "Gradient from two points",
        "body": "With two points $(x_1, y_1)$ and $(x_2, y_2)$:\n\n$$m = \\dfrac{y_2 - y_1}{x_2 - x_1}$$\n\nSubtract in the same order on top and bottom. Through $(1, 2)$ and $(3, 8)$: $m = \\dfrac{8 - 2}{3 - 1} = 3$.",
        "visuals": [
          {
            "type": "diagram",
            "component": "line-graph",
            "props": {
              "xRange": [
                -2,
                6
              ],
              "yRange": [
                -4,
                10
              ],
              "lines": [
                {
                  "m": 3,
                  "c": -1
                }
              ],
              "points": [
                {
                  "x": 1,
                  "y": 2,
                  "label": "(1, 2)"
                },
                {
                  "x": 3,
                  "y": 8,
                  "label": "(3, 8)"
                }
              ]
            },
            "alt": "The line through (1, 2) and (3, 8) with both points marked"
          },
          {
            "type": "worked-example",
            "problem": "Find the gradient of the line through $(-2, 5)$ and $(4, -7)$",
            "steps": [
              {
                "text": "$m = \\dfrac{-7 - 5}{4 - (-2)}$",
                "note": "second point minus first, top and bottom"
              },
              {
                "text": "$= \\dfrac{-12}{6}$",
                "note": "subtracting $-2$ on the bottom gives $4 + 2 = 6$"
              },
              {
                "text": "$m = -2$",
                "note": "negative: down 12 across 6, so the line slopes down"
              }
            ]
          }
        ],
