      {
        "id": "s2",
        "kind": "explain",
        "title": "Negative and fractional gradients",
        "body": "A negative gradient slopes down from left to right. A gradient of $\\tfrac{1}{2}$ rises 1 for every 2 across. Read a gradient from a graph by choosing two points where the line goes exactly through a corner of the squares, then counting up and across between them.\n\n$$m = \\dfrac{\\text{change in } y}{\\text{change in } x}$$",
        "visuals": [
          {
            "type": "diagram",
            "component": "line-graph",
            "props": {
              "xRange": [
                -5,
                5
              ],
              "yRange": [
                -5,
                5
              ],
              "lines": [
                {
                  "m": -1,
                  "c": 3,
                  "label": "y = −x + 3"
                },
                {
                  "m": 0.5,
                  "c": -2,
                  "label": "y = ½x − 2"
                }
              ],
              "points": [
                {
                  "x": 0,
                  "y": 3,
                  "label": "(0, 3)"
                },
                {
                  "x": 3,
                  "y": 0,
                  "label": "(3, 0)"
                },
                {
                  "x": 0,
                  "y": -2,
                  "label": "(0, −2)"
                },
                {
                  "x": 4,
                  "y": 0,
                  "label": "(4, 0)"
                }
              ]
            },
            "alt": "Two lines: y equals minus x plus 3 sloping down, and y equals a half x minus 2 sloping gently up"
          },
          {
            "type": "worked-example",
            "problem": "A line passes through $(0, 5)$ and $(4, 3)$. Find its gradient.",
            "steps": [
              {
                "text": "Change in $y$: $3 - 5 = -2$ (down 2)"
              },
              {
                "text": "Change in $x$: $4 - 0 = 4$ (across 4)"
              },
              {
                "text": "$m = \\dfrac{-2}{4} = -\\dfrac{1}{2}$: down 1 for every 2 across"
              }
            ]
          }
        ],
