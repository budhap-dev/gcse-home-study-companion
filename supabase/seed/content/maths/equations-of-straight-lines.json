      {
        "id": "s3",
        "kind": "explain",
        "title": "Gradient from two points",
        "body": "With two points $(x_1, y_1)$ and $(x_2, y_2)$:\n\n$$m = \\dfrac{y_2 - y_1}{x_2 - x_1}$$\n\nSubtract in the same order on top and bottom. Through $(1, 2)$ and $(3, 8)$: $m = \\dfrac{8 - 2}{3 - 1} = 3$.",
        "visuals": [
          {
            "type": "diagram",
            "component": "line-graph",
            "props": {
              "xRange": [
                -2,
                6
              ],
              "yRange": [
                -4,
                10
              ],
              "lines": [
                {
                  "m": 3,
                  "c": -1
                }
              ],
              "points": [
                {
                  "x": 1,
                  "y": 2,
                  "label": "(1, 2)"
                },
                {
                  "x": 3,
                  "y": 8,
                  "label": "(3, 8)"
                }
              ]
            },
            "alt": "The line through (1, 2) and (3, 8) with both points marked: 2 across and 6 up between them"
          }
        ],
        "check": {
          "id": "c3",
          "type": "numeric",
          "prompt": "Find the gradient of the line through $(2, 3)$ and $(6, 11)$.",
          "marks": 1,
          "gradeBand": "4-5",
          "skill": "gradient from two points",
          "calculator": "either",
          "tags": [],
          "solution": "$\\dfrac{11 - 3}{6 - 2} = \\dfrac{8}{4} = 2$.",
          "markScheme": [
            {
              "code": "B1",
              "marks": 1,
              "description": "2"
            }
          ],
          "discriminators": [],
          "answer": 2,
          "tolerance": 0,
          "unitsRequired": false
        }
      },
      {
        "id": "s4",
        "kind": "worked-example",
        "title": "Equation from a gradient and a point",
        "body": "Put the gradient in, substitute the point to find $c$, then write the whole equation.",
        "visuals": [
          {
            "type": "worked-example",
            "problem": "Gradient 3, through $(2, 7)$",
            "steps": [
              {
                "text": "$y = 3x + c$"
              },
              {
                "text": "$7 = 3(2) + c = 6 + c$"
              },
              {
                "text": "$c = 1$"
              },
              {
                "text": "$y = 3x + 1$"
              }
            ]
          }
        ]
      },
      {
        "id": "s5",
        "kind": "worked-example",
        "title": "Equation from two points",
        "body": "Gradient first, then the same method as before with either point.",
        "visuals": [
          {
            "type": "worked-example",
            "problem": "Through $(-1, 5)$ and $(2, -4)$",
            "steps": [
              {
                "text": "$m = \\dfrac{-4 - 5}{2 - (-1)} = \\dfrac{-9}{3} = -3$"
              },
              {
                "text": "$y = -3x + c$, using $(2, -4)$: $-4 = -6 + c$"
              },
              {
                "text": "$c = 2$"
              },
              {
                "text": "$y = -3x + 2$"
              }
            ]
          }
        ],
        "check": {
