  "lesson": {
    "steps": [
      {
        "id": "s1",
        "kind": "explain",
        "title": "What a surd is",
        "body": "$\\sqrt{9} = 3$ exactly. $\\sqrt{10}$ is $3.162277\\ldots$ and the decimals never end or repeat. A root that cannot be written as a whole number or a fraction is a **surd**. Leaving $\\sqrt{10}$ as $\\sqrt{10}$ is exact; writing $3.16$ is not.",
        "visuals": [
          {
            "type": "worked-example",
            "problem": "Surd or not?",
            "steps": [
              {
                "text": "$\\sqrt{16} = 4$, not a surd"
              },
              {
                "text": "$\\sqrt{17}$: no whole number squares to 17, so it is a surd"
              },
              {
                "text": "$\\sqrt[3]{27} = 3$, not a surd"
              },
              {
                "text": "$\\sqrt{\\tfrac{1}{4}} = \\tfrac{1}{2}$, not a surd"
              }
            ]
          }
        ],
        "check": {
          "id": "c1",
          "type": "multiple-choice",
          "prompt": "Which of these is a surd?",
          "marks": 1,
          "gradeBand": "4-5",
          "skill": "recognising surds",
          "calculator": "non-calculator",
          "tags": [],
          "solution": "9, 16 and 25 are square numbers. 10 is not, so $\\sqrt{10}$ is a surd.",
          "markScheme": [
            {
              "code": "B1",
              "marks": 1,
              "description": "$\\sqrt{10}$"
            }
          ],
          "discriminators": [],
