      {
        "id": "s7",
        "kind": "grade-9",
        "title": "Grade 9: proving right angles and finding vertices",
        "body": "To **show** a triangle is right-angled, find the two gradients at the suspected corner and show their product is $-1$, then say so in a sentence. To find the fourth vertex of a rectangle or square, use the fact that opposite sides are parallel and equal: the shift from $B$ to $C$ is the same as the shift from $A$ to $D$. Both are really gradient questions with a shape drawn around them.",
        "visuals": [
          {
            "type": "diagram",
            "component": "line-graph",
            "props": {
