  "order": 2,
  "lesson": {
    "steps": [
      {
        "id": "s1",
        "kind": "explain",
        "title": "Parallel lines share a gradient",
        "body": "Lines with the **same gradient** never meet: they are parallel. $y = 2x + 1$ and $y = 2x - 3$ climb at the same rate and only differ in where they cross the $y$-axis.",
        "visuals": [
          {
            "type": "diagram",
            "component": "line-graph",
            "props": {
              "xRange": [
                -5,
                5
              ],
              "yRange": [
                -5,
                5
              ],
              "lines": [
                {
                  "m": 2,
                  "c": 1,
                  "label": "y = 2x + 1"
                },
                {
                  "m": 2,
                  "c": -3,
                  "label": "y = 2x − 3"
                }
              ]
            },
            "alt": "Two parallel lines, y equals 2x plus 1 and y equals 2x minus 3, the same slope with different intercepts"
          },
          {
            "type": "worked-example",
            "problem": "Find the equation of the line parallel to $y = 2x + 1$ that passes through $(3, 4)$.",
            "steps": [
              {
                "text": "Parallel, so the gradient is the same: $m = 2$"
              },
              {
                "text": "$y = 2x + c$. Substitute $(3, 4)$: $4 = 6 + c$, so $c = -2$"
              },
              {
                "text": "$y = 2x - 2$"
              }
            ]
          }
        ],
        "check": {
          "id": "c1",
          "type": "multiple-choice",
          "prompt": "Which line is parallel to $y = 3x - 1$?",
