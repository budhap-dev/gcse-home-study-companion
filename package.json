{
  "name": "gcse-home-study-companion",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @study/web dev",
    "dev:admin": "pnpm --filter @study/admin dev",
